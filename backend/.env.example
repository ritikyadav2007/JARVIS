# JARVIS Environment Configuration
# Copy this file to .env and fill in your real keys.
# NEVER commit your actual .env file to Git — it is already in .gitignore.

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Gemini AI (Phase 2)
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optionally change the model (default is gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

